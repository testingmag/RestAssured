<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
	<CustomLevels>
		<CustomLevel name="CUSTOM" intLevel="350" />
	</CustomLevels>

	<Appenders>
		<Console name="LogToConsole" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{HH:mm:ss:SSS}: [%t]: %c{1}:%M === %m %n" />
		</Console>
		<RollingRandomAccessFile
			name="LogToRollingFile" fileName="logs/bloautopost-${date:yyyy-MM-dd_hh-mm-ss}.log"
			filePattern="logs/$${date:yyyy-MM}/app-%d{MM-dd-yyyy}-%i.log.gz">
			<PatternLayout>
				<Pattern>%d:: %t: %C{1}:%M === %msg%n</Pattern>
			</PatternLayout>
			<Policies>
				<TimeBasedTriggeringPolicy />
				<SizeBasedTriggeringPolicy size="10 MB" />
			</Policies>
			<DefaultRolloverStrategy max="10" />
		</RollingRandomAccessFile>
	</Appenders>
	<Loggers>
		<!-- avoid duplicated logs with additivity=false -->
		<!-- <Logger name="com.sd" level="debug" additivity="true"> <AppenderRef 
			ref="LogToConsole"/> </Logger> -->
		<Root level="info">
			<AppenderRef ref="LogToRollingFile" />
			<AppenderRef ref="LogToConsole" />
		</Root>
	</Loggers>
</Configuration>